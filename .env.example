APP_ENV=dev
APP_BASE_URL=https://api.example.com
DATABASE_URL=postgresql+asyncpg://botdesk:botdesk@db:5432/botdesk
JWT_SECRET=change-me
JWT_EXPIRE_MINUTES=10080
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=
ADMIN_EMAIL=admin@example.com
# Used by `python -m app.seed` to create the first admin
ADMIN_PASSWORD=change-me
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
SCHEDULER_ENABLED=true

# Provider switch: default for all clients. A client row may override it.
# own | aisensy
WHATSAPP_PROVIDER=own

# Meta Cloud API (own provider)
META_GRAPH_BASE=https://graph.facebook.com
META_GRAPH_VERSION=v23.0
# For X-Hub-Signature-256 checks
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
# Per-client phone_number_id, WABA id and access token live in the DB (encrypted), not here.

# AiSensy (aisensy provider)
AISENSY_API_BASE=https://apis.aisensy.com/project-apis/v1
# Per-client project id, API password and webhook secret live in the DB (encrypted).

# AI (OpenRouter, OpenAI-compatible API)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=google/gemini-3.7-flash
AI_FALLBACK_MODEL=deepseek/deepseek-v4.1-flash
AI_MAX_OUTPUT_TOKENS=400
AI_TEMPERATURE=0.3
AI_HISTORY_TURNS=12
AI_TIMEOUT_SECONDS=25
# For cost reporting only
USD_TO_INR=88

# Behaviour
BOT_REPLY_MAX_WORDS=60
HANDOFF_AUTO_RELEASE_HOURS=12
# IST, for "night enquiries" stats
NIGHT_START_HOUR=22
NIGHT_END_HOUR=8
# Approved utility template name
OWNER_ALERT_TEMPLATE=new_lead_alert
OWNER_ALERT_TEMPLATE_LANG=en
TRIAL_DAYS=7

# Webhook rate limit per IP (in-memory token bucket)
WEBHOOK_RATE_PER_SEC=20
WEBHOOK_RATE_BURST=100
